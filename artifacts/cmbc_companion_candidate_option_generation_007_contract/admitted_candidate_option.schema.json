{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AdmittedCandidateOption",
  "type": "object",
  "additionalProperties": false,
  "required": ["option_id", "selector_visible_payload", "lineage_trace_ref", "evidence_support_ref", "uncertainty", "admission_decision_ref", "status"],
  "properties": {
    "option_id": {"type": "string"},
    "selector_visible_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "allowed_observation_features", "predicted_effect_vector", "uncertainty", "prior_support_refs", "cost_risk_budget_features"],
      "properties": {
        "option_id": {"type": "string"},
        "allowed_observation_features": {"type": "object", "additionalProperties": {"type": "number"}},
        "predicted_effect_vector": {"type": "object", "additionalProperties": {"type": "number"}},
        "uncertainty": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "prior_support_refs": {"type": "array", "items": {"type": "string"}},
        "cost_risk_budget_features": {"type": "object", "additionalProperties": {"type": "number"}}
      }
    },
    "lineage_trace_ref": {"type": "string"},
    "evidence_support_ref": {"type": "string"},
    "uncertainty": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "admission_decision_ref": {"type": "string"},
    "status": {"type": "string", "enum": ["admitted", "pending", "retired"]},
    "retirement_ref": {"type": ["string", "null"]}
  }
}
