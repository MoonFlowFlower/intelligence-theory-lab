{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_distribution": {
      "additionalProperties": false,
      "properties": {
        "distribution": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "option_id": {
                "type": "string"
              },
              "probability": {
                "type": "number"
              },
              "rank": {
                "type": "integer"
              }
            },
            "required": [
              "option_id",
              "probability",
              "rank"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "distribution"
      ],
      "type": "object"
    },
    "admission_aware_replay_match": {
      "type": "boolean"
    },
    "admission_decision_id": {
      "type": "string"
    },
    "behavior_only_replay_match": {
      "type": "boolean"
    },
    "context_scope": {
      "type": "string"
    },
    "effect_vector_visibility_status": {
      "enum": [
        "base_only_pending_hidden",
        "admitted_delta_visible"
      ],
      "type": "string"
    },
    "feedback_admission_status": {
      "type": "string"
    },
    "proposal_id": {
      "type": "string"
    },
    "selected_option_id": {
      "type": "string"
    },
    "selector_visible_predicted_effect_vector": {
      "additionalProperties": {
        "type": "number"
      },
      "type": "object"
    },
    "trace_id": {
      "type": "string"
    }
  },
  "required": [
    "trace_id",
    "proposal_id",
    "admission_decision_id",
    "feedback_admission_status",
    "context_scope",
    "effect_vector_visibility_status",
    "selector_visible_predicted_effect_vector",
    "action_distribution",
    "selected_option_id",
    "behavior_only_replay_match",
    "admission_aware_replay_match"
  ],
  "title": "AdmissionAwareReplayTrace",
  "type": "object"
}
