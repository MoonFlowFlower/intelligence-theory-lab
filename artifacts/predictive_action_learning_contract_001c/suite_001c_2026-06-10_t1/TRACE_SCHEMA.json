{
 "chronology_rule": "pre_commit_receipt.commit_monotonic_ns must be < obs_reveal_monotonic_ns of the same step; receipts must match commits.log.jsonl by seq and payload hash",
 "event_types": [
  "RUN_META",
  "PRE_STEP",
  "POST_STEP",
  "REPLAY_STEP"
 ],
