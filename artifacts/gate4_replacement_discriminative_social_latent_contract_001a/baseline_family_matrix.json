      ],
      "block_condition": "no_material_drop_when_state_dependency_claimed"
    },
    {
      "id": "no_feedback_ablation",
      "required": true,
      "role": "candidate ablation without feedback update",
      "minimum_controls": [
        "feedback_removed_before_update",
        "real_episode_rerun",
        "same_observations_otherwise"
      ],
      "block_condition": "no_material_drop_when_feedback_dependency_claimed"
    },
    {
      "id": "no_action_ablation",
      "required": true,
      "role": "candidate ablation without action-conditioning",
      "minimum_controls": [
        "action_input_removed_from_update",
        "real_episode_rerun",
        "same_feedback_interface"
      ],
      "block_condition": "no_material_drop_when_action_conditioning_claimed"
    },
    {
      "id": "oracle_label_positive_control_only",
      "required": true,
      "role": "positive control proving the task is learnable if forbidden labels leak",
      "minimum_controls": [
        "clearly_marked_oracle_only",
        "excluded_from_candidate_margin",
        "must_not_be_used_as_baseline_to_beat"
      ],
      "block_condition": "oracle_access_available_to_candidate_or_non_oracle_baseline"
    }
  ]
